{
  "name": "mgsm-issue-tracker",
  "version": "1.0.0",
  "description": "Public-facing issue tracker for MGSM, the game-server monetization platform.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --minify --dts --format cjs,esm --out-dir dist",
    "dev": "tsup src/index.ts --dts --format cjs,esm --out-dir dist --watch --onSuccess \"node dist/index.js --env=.env.local\"",
    "start": "node dist/index.js --env=.env.local",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mirasaki-MGSM/issue-tracker.git"
  },
  "keywords": [
    "issue-tracker",
    "issue",
    "issues",
    "github-discord",
    "discord-github",
    "sync-issues",
    "discord-forum",
    "forum-channel"
  ],
  "author": {
    "name": "Richard Hillebrand (Mirasaki)",
    "email": "me@mirasaki.dev",
    "url": "https://mirasaki.dev"
  },
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/Mirasaki-MGSM/issue-tracker/issues"
  },
  "homepage": "https://github.com/Mirasaki-MGSM/issue-tracker#readme",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.12.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  }
}
